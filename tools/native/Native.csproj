  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <StorybrewDir Condition="'$(StorybrewDir)' == ''">D:\software\storybrew.1.96</StorybrewDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Tsukinami.cs" Link="Tsukinami.cs" />
    <Reference Include="StorybrewCommon"><HintPath>$(StorybrewDir)/StorybrewCommon.dll</HintPath></Reference>
    <Reference Include="OpenTK"><HintPath>$(StorybrewDir)/OpenTK.dll</HintPath></Reference>
  </ItemGroup>
</Project>
